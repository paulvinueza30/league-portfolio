{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/cmd/vercel/main.go",
      "use": "@vercel/go"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/cmd/vercel/main.go" }
  ]
}